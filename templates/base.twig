<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ grid_name }}{% endblock %}</title>
{% block style %}<link rel="stylesheet" href="{{ static_url }}css/page.css">{% endblock %}
</head>
{# The layout adapts to who asks: a viewer shows the content alone, a browser has the top bar and the footer too #}
<body class="{{ viewer ? 'viewer' : 'browser' }}">
{% if not viewer %}
<a class="skip" href="#main">{{ labels.skip }}</a>
<header class="topbar">
{% block topbar %}
<a class="brand" href="/">{% if logo_url %}<img class="logo" src="{{ logo_url }}" alt="">{% endif %}<span>{{ grid_name }}</span></a>
<nav>{% for item in menu %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</nav>
{% endblock %}
</header>
{% endif %}
<main id="main">
{% block content %}{% endblock %}
</main>
{% if not viewer %}
<footer>
{% block footer %}<span>{{ grid_name }}</span> · <span>{{ labels.powered_by }}</span>{% endblock %}
</footer>
{% endif %}
</body>
</html>
