<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ grid_name }}{% endblock %}</title>
        {# The styles in the head, versioned by their date: the page is styled when it shows, and a browser keeps them #}
        <link rel="stylesheet" href="{{ stylesheet }}">
        {% for css in assets.css %}<link rel="stylesheet" href="{{ css }}">{% endfor %}
    </head>
    {# One layout for every page, left to right: what the grid is, the main content, what is new. A viewer shows the content
       alone, except on the splash page; a browser has the top bar and the footer too. #}
    <body class="{{ viewer ? 'viewer' : 'browser' }} page-{{ slug }}">
        {% if not viewer %}
            <a class="skip" href="#main">{{ labels.skip }}</a>
            <header class="topbar">
                <a class="brand" href="/">
                    {% if logo_url %}<img class="logo" src="{{ logo_url }}" alt="">{% endif %}
                    <span>{{ grid_name }}</span>
                </a>
                <nav>
                    {% for item in menu %}<a href="{{ item.url }}"{% if item.slug == slug %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
                </nav>
            </header>
        {% endif %}
        <div class="layout {{ sidebars ? 'with-sidebars' : 'content-only' }}">
            {% if sidebars %}
                <aside class="sidebar sidebar-left">
                    {{ grid_info }}
                    {{ grid_status }}
                </aside>
            {% endif %}
            <main id="main">
                {# The notices to the visitor (View::notify()), at the start of the content #}
                {% if notices %}
                    <div class="notices" role="status">
                        {% for notice in notices %}<p class="notice notice-{{ notice.level }}">{{ notice.text }}</p>{% endfor %}
                    </div>
                {% endif %}
                {{ main }}
            </main>
            {% if sidebars %}
                <aside class="sidebar sidebar-right">
                    {{ motd }}
                    {{ news }}
                </aside>
            {% endif %}
        </div>
        {% if not viewer %}
            <footer>
                <span>{{ grid_name }}</span> · <span>{{ labels.powered_by }}</span>
            </footer>
        {% endif %}
        {% for js in assets.js %}<script src="{{ js }}"></script>{% endfor %}
    </body>
</html>
