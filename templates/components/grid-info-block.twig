{% extends 'components/block-component.twig' %}
{% block body %}
    <table class="block-table">
        {% for row in rows %}
            <tr>
                <th scope="row">{{ row.label }}</th>
                <td>{% if row.links ?? [] %}{{ tp_link(row.links, row.value) }}{% elseif row.url %}<a href="{{ row.url }}">{{ row.value }}</a>{% else %}{{ row.value }}{% endif %}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
