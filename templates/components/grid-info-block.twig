{% extends 'components/block-component.twig' %}
{% block body %}
    <table class="block-table">
        {% for row in rows %}
            <tr>
                <th scope="row">{{ row.label }}</th>
                <td>
                    {% if row.url %}<a href="{{ row.url }}">{{ row.value }}</a>{% elseif row.copy %}<code class="login-uri">{{ row.value }}</code>{% else %}{{ row.value }}{% endif %}
                    {% if row.hop %}<a class="hop" href="{{ row.hop }}">{{ row.hop }}</a>{% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
