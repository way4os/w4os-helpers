{% extends 'components/block-component.twig' %}
{% block body %}
    <ol class="popular-places">
        {% for row in rows %}
            <li>{% if row.url %}<a href="{{ row.url }}">{{ row.label }}</a>{% else %}{{ row.label }}{% endif %}{% if row.value %} <small>{{ row.value }}</small>{% endif %}</li>
        {% endfor %}
    </ol>
{% endblock %}
