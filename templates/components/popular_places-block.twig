{% extends 'components/block-component.twig' %}
{# A grid of cards, as many rows as it needs: the picture of the parcel (the grid's placeholder without one), its name over it, its
   region under it (assets/css/places.css) #}
{% block body %}
    {% if unavailable ?? false %}<p class="block-unavailable">{{ labels.unavailable }}</p>{% endif %}
    <div class="places">
        {% for row in rows %}
            <a class="place" {% if row.url %}href="{{ row.url }}"{% endif %}>
                <img class="place-picture{{ row.picture ? '' : ' no-picture' }}" src="{{ assets }}/{{ row.picture ?: placeholder }}.jpg" alt="" loading="lazy">
                <span class="place-name">{{ row.label }}</span>
                {% if row.value %}<span class="place-region">{{ row.value }}</span>{% endif %}
            </a>
        {% endfor %}
    </div>
{% endblock %}
