{# The guide keeps its own markup (#guide), the viewers' panel and the css of assets/css/guide.css depend on it: a card for each
   category or destination, the picture of its parcel (the grid's placeholder without one), on one row in a viewer (body.viewer) #}
<div id="guide" class="block block-guide">
    <div class="header">
        {% if category is defined and category and back is defined and back %}<h2>{{ category }}</h2>{% else %}<h1>{{ category ?? title }}</h1>{% endif %}
        {% if back is defined and back %}<a href="{{ back.url }}" class="back">{{ back.label }}</a>{% endif %}
        <span class="disclaimer">{{ disclaimer }}</span>
    </div>
    {% if reason is defined %}<!-- {{ reason }} -->{% endif %}
    {% if text is defined %}
        <div class="error">{{ text }}</div>
    {% else %}
        <div class="list">
            {% for item in items %}
                <a class="item" href="{{ item.url }}">
                    <img class="thumbnail" src="{{ assets }}/{{ item.picture ?: placeholder }}.jpg" alt="" loading="lazy">
                    <span class="name">{{ item.name }}</span>
                    {% if item.data %}<span class="data" title="{{ item.data }}">{% for part in item.data|split('/') %}{{ part }}{% if not loop.last %}/<wbr>{% endif %}{% endfor %}</span>{% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
