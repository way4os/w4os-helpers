{# The guide keeps its own markup (#guide), the viewers' panel and the css of assets/css/guide.css depend on it: a card for each
   category or destination, the picture of its parcel (the grid's placeholder without one), on one row in a viewer. In a viewer it
   is its Destinations panel (client-viewer); in a browser a block of the page as the others (client-browser): its title is theirs #}
<div id="guide" class="block block-guide client-{{ client }}" data-helpers-block="{{ helpers_block }}">
    <div class="header">
        {% set browsing = category is defined and category and back is defined and back %}
        {# In a browser, the title of the guide; the category under it while the categories are browsed #}
        {% if client != 'viewer' %}{% if title %}<{{ level }} class="block-title">{{ title }}</{{ level }}>{% endif %}{% if browsing %}<span class="category">{{ category }}</span>{% endif %}
        {% elseif browsing %}<h2>{{ category }}</h2>{% elseif category ?? title %}<h1>{{ category ?? title }}</h1>{% endif %}
        {% if back is defined and back %}<a href="{{ back.url }}" class="back">{{ back.label }}</a>{% endif %}
    </div>
    {% if unavailable ?? false %}
        <p class="block-unavailable">{{ labels.unavailable }}</p>
    {% else %}
        <div class="list">
            {% for item in items %}
                {% set card %}{{ picture(assets ~ '/' ~ (item.picture ?: placeholder) ~ '.jpg', item.name, 'thumbnail' ~ (item.picture ? '' : ' no-picture')) }}<span class="name">{{ item.name }}</span>{% if item.data %}<span class="data" title="{{ item.data }}">{% for part in item.data|split('/') %}{% for piece in part|split(':') %}{{ piece }}{% if not loop.last %}:<wbr>{% endif %}{% endfor %}{% if not loop.last %}/<wbr>{% endif %}{% endfor %}</span>{% endif %}{% endset %}
                {# A destination: its teleport link over the card, the button of its other links in a corner (guide.css); a category: its page #}
                {% if item.links is defined %}<div class="item">{{ tp_link(item.links, item.name, card) }}</div>{% else %}<a class="item" href="{{ item.url }}">{{ card }}</a>{% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>
