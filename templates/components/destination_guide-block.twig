{# The guide keeps its own markup (#guide), the viewers' panel and the css of assets/css/guide.css depend on it: a card for each
   category or destination, the picture of its parcel (the grid's placeholder without one), on one row in a viewer. In a viewer it
   is its Destinations panel (client-viewer); in a browser a block of the page as the others (client-browser): its title is theirs #}
<div id="guide" class="block block-guide client-{{ client }}" data-helpers-block="{{ helpers_block }}">
    <div class="header">
        {% set heading = (category is defined and category and back is defined and back) ? category : (category ?? title) %}
        {% if heading and client != 'viewer' %}<{{ level }} class="block-title">{{ heading }}</{{ level }}>
        {% elseif category is defined and category and back is defined and back %}<h2>{{ category }}</h2>{% elseif heading %}<h1>{{ heading }}</h1>{% endif %}
        {% if back is defined and back %}<a href="{{ back.url }}" class="back">{{ back.label }}</a>{% endif %}
        <span class="disclaimer">{{ disclaimer }}</span>
    </div>
    {% if reason is defined %}<!-- {{ reason }} -->{% endif %}
    {% if unavailable ?? false %}
        <p class="block-unavailable">{{ labels.unavailable }}</p>
    {% elseif text is defined %}
        <div class="error">{{ text }}</div>
    {% else %}
        <div class="list">
            {% for item in items %}
                <a class="item" href="{{ item.url }}">
                    <img class="thumbnail{{ item.picture ? '' : ' no-picture' }}" src="{{ assets }}/{{ item.picture ?: placeholder }}.jpg" alt="" loading="lazy">
                    <span class="name">{{ item.name }}</span>
                    {% if item.data %}<span class="data" title="{{ item.data }}">{% for part in item.data|split('/') %}{% for piece in part|split(':') %}{{ piece }}{% if not loop.last %}:<wbr>{% endif %}{% endfor %}{% if not loop.last %}/<wbr>{% endif %}{% endfor %}</span>{% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
