<section class="block block-search search-{{ topic }}" data-helpers-block="{{ helpers_block }}">
    {% if title %}<{{ level }} class="block-title">{{ title }}</{{ level }}>{% endif %}
    {# The kinds of search, always offered: each its own form and its own results, as in the viewers #}
    <nav class="search-topics" role="tablist">
        {% for t in topics %}<a role="tab" href="{{ t.url }}"{% if t.current %} aria-current="page" aria-selected="true"{% endif %}>{{ t.title }}</a>{% endfor %}
    </nav>
    {# One row of its criteria, each as wide as it needs, the words taking the rest, the button at its end #}
    <search>
        <form class="search-form" action="{{ action }}" method="get">
            <input type="hidden" name="go" value="1">
            {% for field in fields %}
                {% if field.type == 'ratings' %}
                    <span class="search-checks" role="group" aria-label="{{ field.label }}">
                        {% for option in field.options %}<label><input type="checkbox" name="rating[]" value="{{ option.value }}"{% if option.selected %} checked{% endif %}> {{ option.label }}</label>{% endfor %}
                    </span>
                {% elseif field.type == 'when' %}
                    <span class="search-when" role="group" aria-label="{{ field.label }}">
                        {% for option in field.options %}<label><input type="radio" name="when" value="{{ option.value }}"{% if option.selected %} checked{% endif %}> {{ option.label }}</label>{% endfor %}
                        <span class="search-day">
                            {% if not field.at_min %}<a href="{{ field.previous_url }}" aria-label="{{ field.previous }}" title="{{ field.previous }}">&larr;</a>{% endif %}
                            {# The date picker of the browser, in its language; its value ISO; never before the first event to come #}
                            <input class="search-date" type="date" name="date" value="{{ field.iso }}" min="{{ field.min }}" aria-label="{{ field.label }}" data-search-day>
                            <a href="{{ field.next_url }}" aria-label="{{ field.next }}" title="{{ field.next }}">&rarr;</a>
                        </span>
                    </span>
                {% elseif field.type == 'select' %}
                    <select class="search-select-menu" name="{{ field.name }}" aria-label="{{ field.label }}">
                        {% for option in field.options %}<option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>{% endfor %}
                    </select>
                {% elseif field.type == 'number' %}
                    <span class="search-number"><label for="search-{{ field.name }}">{{ field.label }}</label><span class="search-affix"><input id="search-{{ field.name }}" type="number" min="0" name="{{ field.name }}" value="{{ field.value }}"><span class="search-suffix" aria-hidden="true">{{ field.suffix }}</span></span></span>
                {% else %}
                    <input class="search-words" type="text" enterkeyhint="search" name="{{ field.name }}" value="{{ field.value }}" aria-label="{{ field.label }}"{% if field.placeholder is defined %} placeholder="{{ field.placeholder }}"{% endif %}{% if field.min is defined %} minlength="{{ field.min }}"{% endif %}{% if field.required ?? false %} required{% endif %}{% if loop.first %} autofocus{% endif %}>
                {% endif %}
            {% endfor %}
            <button type="submit">{{ submit }}</button>
        </form>
    </search>
    {% if not embedded %}
        {% if unavailable ?? false %}
            <p class="block-unavailable">{{ labels.unavailable }}</p>
        {% elseif not asked %}
            {% if note %}<p class="search-none">{{ note }}</p>{% endif %}
        {% else %}
            {# The list as the viewers have it, its columns sorting it; the result chosen shows its detail beside it (w4os-views) #}
            {{ list_detail(list, empty, assets) }}
        {% endif %}
    {% endif %}
</section>
