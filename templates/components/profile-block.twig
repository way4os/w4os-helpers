<section class="block block-profile">
    <h1 class="block-title">{{ title }}</h1>
    {% if not found %}
        <p>{{ labels.profile_not_found }}</p>
    {% else %}
        {% if account_title %}<p class="profile-meta"><span class="profile-title">{{ account_title }}</span></p>{% endif %}
        {% if not published %}
            <p class="profile-private">{{ labels.profile_private }}</p>
        {% elseif sections %}
            {# The sections of the viewer's profile, in the order of its tabs: links to each, made tabs by the script below; without
               it, every section shows, one after the other #}
            {% set titles = {'second-life': labels.second_life, 'web': labels.web, 'interests': labels.interests, 'picks': labels.picks, 'classifieds': labels.classifieds, 'first-life': labels.first_life} %}
            {% if sections|length > 1 %}
                {# The classes of the tabs of Grav's Form plugin (form-tabs, tabs-nav, tab__link, active): a site's theme draws them as its forms' tabs #}
                <nav class="profile-tabs form-tabs" aria-label="{{ labels.profile_sections }}">
                    <ul class="tabs-nav">{% for id in sections %}<li><a class="tab__link" href="#profile-{{ id }}"><span>{{ titles[id] }}</span></a></li>{% endfor %}</ul>
                </nav>
            {% endif %}
            {% if 'second-life' in sections %}
                <section id="profile-second-life" class="profile-section">
                    <h2>{{ labels.second_life }}</h2>
                    {# As the 2nd Life tab of the viewer: the picture in its own proportions, then who the avatar is, then its about #}
                    <div class="profile-identity">
                        <img class="profile-photo" src="{{ assets }}/{{ picture }}.jpg" alt="">
                        <dl class="profile-details profile-identity-details">
                            <dt>{{ labels.name }}</dt><dd>{{ title }}</dd>
                            {% if key %}<dt>{{ labels.key }}</dt><dd><code>{{ key }}</code></dd>{% endif %}
                            {% if member_since %}<dt>{{ labels.born }}</dt><dd>{{ member_since }}{% if age is not null %} ({{ age }}){% endif %}</dd>{% endif %}
                            {% if role %}<dt>{{ labels.account }}</dt><dd>{{ role }}</dd>{% endif %}
                            {% if partner %}<dt>{{ labels.partner }}</dt><dd>{% if partner.url %}<a href="{{ partner.url }}">{{ partner.name }}</a>{% else %}{{ partner.name }}{% endif %}</dd>{% endif %}
                        </dl>
                    </div>
                    {% if about %}<div class="profile-about">{{ about|nl2br }}</div>{% endif %}
                    {# Then its groups, as the viewer lists them under its about #}
                    {% if groups %}<dl class="profile-details profile-groups"><dt>{{ labels.groups }}</dt><dd>{{ groups|join(', ') }}</dd></dl>{% endif %}
                </section>
            {% endif %}
            {% if 'web' in sections %}
                <section id="profile-web" class="profile-section">
                    <h2>{{ labels.web }}</h2>
                    {% if web %}<p><a href="{{ web }}" rel="nofollow ugc">{{ web }}</a></p>{% else %}<p class="profile-none">{{ labels.none }}</p>{% endif %}
                </section>
            {% endif %}
            {% if 'interests' in sections %}
                <section id="profile-interests" class="profile-section">
                    <h2>{{ labels.interests }}</h2>
                    {% if not (wants_list or wants or skills_list or skills or languages) %}<p class="profile-none">{{ labels.none }}</p>{% endif %}
                    <dl class="profile-details">
                        {% if wants_list or wants %}<dt>{{ labels.wants }}</dt><dd>{{ wants_list|join(', ') }}{% if wants_list and wants %}<br>{% endif %}{{ wants|nl2br }}</dd>{% endif %}
                        {% if skills_list or skills %}<dt>{{ labels.skills }}</dt><dd>{{ skills_list|join(', ') }}{% if skills_list and skills %}<br>{% endif %}{{ skills|nl2br }}</dd>{% endif %}
                        {% if languages %}<dt>{{ labels.languages }}</dt><dd>{{ languages }}</dd>{% endif %}
                    </dl>
                </section>
            {% endif %}
            {% if 'picks' in sections %}
                <section id="profile-picks" class="profile-section">
                    <h2>{{ labels.picks }}</h2>
                    {% include 'components/profile-items.twig' with {items: picks, kind: 'pick'} %}
                </section>
            {% endif %}
            {% if 'classifieds' in sections %}
                <section id="profile-classifieds" class="profile-section">
                    <h2>{{ labels.classifieds }}</h2>
                    {% include 'components/profile-items.twig' with {items: classifieds, kind: 'classified'} %}
                </section>
            {% endif %}
            {% if 'first-life' in sections %}
                <section id="profile-first-life" class="profile-section">
                    <h2>{{ labels.first_life }}</h2>
                    <div class="profile-identity">
                        <img class="profile-photo" src="{{ assets }}/{{ first_picture }}.jpg" alt="">
                        {% if first_life %}<div class="profile-first-life">{{ first_life|nl2br }}</div>{% else %}<p class="profile-none">{{ labels.none }}</p>{% endif %}
                    </div>
                </section>
            {% endif %}
            {% if sections|length > 1 %}
            <script>
            // The links to the sections as tabs: one section shown at a time, the arrow keys move between the tabs
            (function (block) {
                var nav = block && block.querySelector('.profile-tabs');
                if (!nav || !document.querySelectorAll) { return; }
                var tabs = nav.querySelectorAll('a');
                var panels = [];
                // The tab open is in the address (#interests): a reload opens it again
                function remember(index) {
                    history.replaceState && history.replaceState(null, '', '#' + tabs[index].getAttribute('href').slice(1).replace(/^profile-/, ''));
                }
                function select(index, focus) {
                    for (var i = 0; i < tabs.length; i++) {
                        tabs[i].setAttribute('aria-selected', i === index ? 'true' : 'false');
                        tabs[i].className = 'tab__link' + (i === index ? ' active' : '');
                        tabs[i].tabIndex = i === index ? 0 : -1;
                        panels[i].hidden = i !== index;
                    }
                    focus && tabs[index].focus();
                }
                nav.querySelector('ul').setAttribute('role', 'tablist');
                var start = 0;
                for (var i = 0; i < tabs.length; i++) {
                    var id = tabs[i].getAttribute('href').slice(1);
                    panels[i] = document.getElementById(id);
                    tabs[i].parentNode.setAttribute('role', 'presentation');
                    tabs[i].setAttribute('role', 'tab');
                    tabs[i].id = id + '-tab';
                    tabs[i].setAttribute('aria-controls', id);
                    panels[i].setAttribute('role', 'tabpanel');
                    panels[i].setAttribute('aria-labelledby', id + '-tab');
                    // The tab says what the section is: its heading is for the page without the tabs
                    panels[i].querySelector('h2').hidden = true;
                    (location.hash === '#' + id || location.hash === '#' + id.replace(/^profile-/, '')) && (start = i);
                    (function (index) {
                        tabs[index].onclick = function (event) { event.preventDefault(); select(index); remember(index); };
                        tabs[index].onkeydown = function (event) {
                            var step = { ArrowRight: 1, ArrowLeft: -1, Right: 1, Left: -1 }[event.key];
                            if (step) { event.preventDefault(); var next = (index + step + tabs.length) % tabs.length; select(next, true); remember(next); }
                        };
                    })(i);
                }
                block.className += ' profile-tabbed';
                select(start);
                // A link to a tab of the page (#picks) opens it
                window.addEventListener && window.addEventListener('hashchange', function () {
                    for (var h = 0; h < tabs.length; h++) {
                        var tab = tabs[h].getAttribute('href').slice(1);
                        (location.hash === '#' + tab || location.hash === '#' + tab.replace(/^profile-/, '')) && select(h);
                    }
                });
            })(document.currentScript && document.currentScript.parentNode);
            </script>
            {% endif %}
        {% endif %}
    {% endif %}
</section>
