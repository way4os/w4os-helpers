{
    "name": "w4os/w4os-helpers",
    "description": "Helpers needed to enable common functionalties like search, currency, events in OpenSimulator grids.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gudule Lapointe",
            "email": "gudule@speculoos.world"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "magicoli/opensim-rest-php": "@dev",
        "w4os/w4os-engine": "@dev",
        "twig/twig": "^3.8",
        "slim/slim": "^4",
        "slim/psr7": "^1",
        "php-di/php-di": "^7",
        "php-di/slim-bridge": "^3",
        "nesbot/carbon": "3.15.1",
        "gettext/gettext": "^5.7",
        "gettext/translator": "^1.2",
        "w4os/w4os-views": "@dev"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "magicoli/pest-failure-summary": "^1.0",
        "pestphp/pest": "^3.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "squizlabs/php_codesniffer": "^4.0",
        "magicoli/bash-tools": "^1.0.7",
        "magicoli/build-tools": "^0.2.0"
    },
    "repositories": [
        {
            "name": "w4os/w4os-engine",
            "url": "../opensim-engine/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "magicoli/opensim-rest-php",
            "url": "../opensim-rest-php/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "w4os/w4os-views",
            "url": "../w4os-views/",
            "type": "path",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "scripts": {
        "test": "pest",
        "logos": "php -r 'if (getenv(\"COMPOSER_DEV_MODE\") === \"0\") { exit; } foreach (glob(\"vendor/w4os/w4os-engine/share/images/logos/*.png\") ?: [] as $logo) { copy($logo, \"assets/images/logos/\" . basename($logo)); }'",
        "post-install-cmd": [
            "@logos"
        ],
        "post-update-cmd": [
            "@logos"
        ]
    },
    "suggest": {
        "ext-gettext": "translations of the messages, which stay in English without it",
        "ext-imagick": "textgen.php, the text images"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "W4OS\\Helpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W4OS\\Helpers\\Tests\\": "tests/"
        }
    }
}
