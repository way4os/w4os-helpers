{
    "name": "magicoli/opensim-helpers",
    "description": "Helpers needed to enable common functionalties like search, currency, events in OpenSimulator grids.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gudule Lapointe",
            "email": "gudule@speculoos.world"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "phpxmlrpc/phpxmlrpc": "^4.11",
        "magicoli/opensim-rest-php": "@dev",
        "magicoli/opensim-engine": "@dev",
        "twig/twig": "^3.8",
        "slim/slim": "^4",
        "slim/psr7": "^1",
        "php-di/php-di": "^7",
        "php-di/slim-bridge": "^3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "magicoli/pest-failure-summary": "^1.0",
        "pestphp/pest": "^3.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "squizlabs/php_codesniffer": "^4.0",
        "magicoli/bash-tools": "^1.0.7",
        "magicoli/build-tools": "^0.1.2"
    },
    "repositories": [
        {
            "name": "magicoli/opensim-engine",
            "url": "../opensim-engine/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "magicoli/opensim-rest-php",
            "url": "../opensim-rest-php/",
            "type": "path",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "scripts": {
        "test": "pest"
    },
    "suggest": {
        "ext-gettext": "translations of the messages, which stay in English without it",
        "ext-imagick": "textgen.php, the text images"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OpenSim\\Helpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSim\\Helpers\\Tests\\": "tests/"
        }
    }
}
