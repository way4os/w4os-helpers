# Environment of the tests: copy this file as tests/.env (git-ignored) and edit it. It is read after the .env of the project.

# Where the container checks run is said on their command line (--connection NAME or --local), never here

# Memory of the container (default 1g: the database server is in it)
# MEMORY=1g

# apt over https, for a machine whose port 80 is closed (the packages are still checked by their signatures)
# APT_HTTPS=1

# Where the Debian packages of the other projects are, the newest of each is taken
# DEPS_ENGINE=../opensim-engine/dist
# DEPS_REST=../opensim-rest-php/dist
# DEPS_CONTAINER=../container-tools/dist
