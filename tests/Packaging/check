#!/usr/bin/env bash
# Tries the files of dist/ (made by dev/build.sh) in a clean container (podman), the way a grid runs them: the Debian package
# installs with the packages it needs (the engine makes the system layout and its account), php-fpm and Caddy serve the helpers
# with the snippet of the kit, as the user of the web server. A visit runs the tasks of the search, a picture of the grid is cached,
# in the folders the package made for the web server; the zip answers too. Exits non-zero when a check fails.
#
#   tests/Packaging/check --connection NAME|--local [base image]     default: Debian 12; docker.io/library/ubuntu:24.04 for another
#   DEPS_ENGINE=folder DEPS_REST=folder DEPS_CONTAINER=folder
#                                            where the Debian packages of the other projects are, the newest of each is taken
#                                            (default: ../opensim-engine/dist, ../opensim-rest-php/dist, ../container-tools/dist)
#   MEMORY=1g                                memory of the container (the database server is in it)
#   APT_HTTPS=1                              apt over https, for a machine whose port 80 is closed (the packages are still
#                                            checked by their signatures)
#   All can be set in tests/.env (see tests/.env.example), after the .env of the project.

set -eo pipefail
# Where the container runs, said on the command line: --connection NAME (a podman system connection, --container NAME is the
# same), or --local for the podman of this machine. Never an environment variable: it may not be exported, sudo drops it. On
# macOS one of them is required (its podman machine is too small for this); elsewhere the podman of the machine is the default.
CONNECTION= LOCAL=0
while [[ "${1:-}" == --* ]]; do
    case $1 in
    --connection | --container) CONNECTION=${2:-}; [[ -n $CONNECTION ]] || { echo "check: $1 needs the name of a podman connection" >&2; exit 2; }; shift 2 ;;
    --connection=* | --container=*) CONNECTION=${1#*=}; shift ;;
    --local) LOCAL=1; shift ;;
    *) echo "check: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ -z $CONNECTION && $LOCAL != 1 && $(uname -s) == Darwin ]]; then
    echo "check: say where the container runs: --connection NAME (podman system connection list), or --local for this Mac" >&2
    exit 2
fi
podman=(podman ${CONNECTION:+--connection "$CONNECTION"})
BASE=${1:-docker.io/library/debian:bookworm}
cd "$(dirname "$0")/../.."
[[ -f vendor/bin/bash-helpers ]] || { echo "bash-tools is not installed: composer install" >&2; exit 1; }
source vendor/bin/bash-helpers

# The environment of the project (.env) and the one of the tests (tests/.env): MEMORY...
ENV_SLUG=tests read_env || true
[[ -z $CONNECTION ]] || log "Podman connection: $CONNECTION"
DEPS_ENGINE=${DEPS_ENGINE:-$PWD/../opensim-engine/dist}
DEPS_REST=${DEPS_REST:-$PWD/../opensim-rest-php/dist}
DEPS_CONTAINER=${DEPS_CONTAINER:-$PWD/../container-tools/dist}

# What the container needs is sent to it as a tar stream, so it can run on any machine:
# --connection NAME (see podman system connection) uses the podman of another one
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/deps"
ln -s "$PWD/dist" "$stage/dist"
ln -s "$DEPS_ENGINE" "$stage/deps/engine"
ln -s "$DEPS_REST" "$stage/deps/rest"
ln -s "$DEPS_CONTAINER" "$stage/deps/container"
COPYFILE_DISABLE=1 tar -chf - -C "$stage" dist deps | "${podman[@]}" run --rm -i --memory="${MEMORY:-1g}" -e APT_HTTPS="${APT_HTTPS:-}" "$BASE" bash -c '
tar -xf - --no-same-owner --warning=no-unknown-keyword -C /
status=0
check() { if eval "$2"; then echo "   ok: $1"; else echo "   FAILED: $1"; status=1; fi; }
newest() { ls -v "$1"/"$2"_*.deb 2>/dev/null | tail -1; }
http_code() { curl -s -o /dev/null -w %{http_code} "$1"; }
# A previous version of a package, which had the libraries bundled as folders of vendor/magicoli (dpkg does not
# replace a folder by a link when it upgrades): installed in place of the real one
previous() { # package, libraries
    local pkg=$1 root lib
    shift
    root=/tmp/previous-$pkg
    rm -rf $root
    mkdir -p $root/DEBIAN
    for lib in "$@"; do
        mkdir -p $root/usr/share/$pkg/vendor/magicoli/$lib
        : >$root/usr/share/$pkg/vendor/magicoli/$lib/bundled.php
    done
    printf "Package: $pkg\nVersion: 0.0.1\nArchitecture: all\nMaintainer: test <test@example.org>\nDescription: previous version, libraries bundled\n" >$root/DEBIAN/control
    dpkg-deb -b $root /tmp/previous-$pkg.deb >/dev/null
    dpkg -r --force-depends $pkg >/dev/null 2>&1
    dpkg -i --force-depends /tmp/previous-$pkg.deb >/dev/null 2>&1
}
export DEBIAN_FRONTEND=noninteractive
if [ -n "$APT_HTTPS" ]; then
    sed -i "s#http://#https://#g" /etc/apt/sources.list.d/*.sources /etc/apt/sources.list 2>/dev/null || true
    echo "Acquire::https::Verify-Peer \"false\";" >/etc/apt/apt.conf.d/99https
fi
apt-get update -qq >/dev/null
apt-get install -y -qq curl unzip php-fpm caddy mariadb-server imagemagick \
    "$(newest /deps/container container-tools)" "$(newest /deps/rest opensim-rest-php)" "$(newest /deps/engine w4os-engine)" "$(newest /dist w4os-helpers)" >/tmp/apt.log 2>&1 ||
    { tail -20 /tmp/apt.log; exit 1; }
php=$(php -r "echo PHP_MAJOR_VERSION . \".\" . PHP_MINOR_VERSION;")

echo "The package"
check "it is installed, it depends on the engine and rest-php" "dpkg -s w4os-helpers | grep -q \"^Depends:.*w4os-engine.*opensim-rest-php\""
check "its application is in /usr/share/w4os-helpers, its document root public/" "[ -f /usr/share/w4os-helpers/public/index.php ] && [ -f /usr/share/w4os-helpers/src/App.php ] && [ -f /usr/share/w4os-helpers/vendor/autoload.php ]"
check "the engine and rest-php come from their packages, by links" "[ -L /usr/share/w4os-helpers/vendor/w4os/w4os-engine ] && [ -L /usr/share/w4os-helpers/vendor/magicoli/opensim-rest-php ] && [ -f /usr/share/w4os-helpers/vendor/w4os/w4os-engine/src/Models/Grid.php ]"
check "the libraries it brings itself are in its vendor folder" "[ -d /usr/share/w4os-helpers/vendor/slim/slim ] && [ -d /usr/share/w4os-helpers/vendor/twig/twig ]"
check "the folders it writes as the web server are made for www-data" "[ \"\$(stat -c %U /var/cache/w4os-helpers/tasks)\" = www-data ] && [ \"\$(stat -c %U /var/cache/w4os-helpers/cache)\" = www-data ]"
check "the folders of the install are the account of the instances, which the web server cannot write" "getent passwd opensim >/dev/null && ! runuser -u www-data -- test -w /var/lib/opensim && ! runuser -u www-data -- test -w /var/cache/opensim"

echo "A grid served by php-fpm and Caddy"
(mysqld_safe >/dev/null 2>&1 &)
for i in $(seq 1 30); do mysqladmin ping >/dev/null 2>&1 && break; sleep 1; done
mysql -e "CREATE DATABASE robust; CREATE USER \"os\"@\"localhost\" IDENTIFIED BY \"pw\"; GRANT ALL ON robust.* TO \"os\"@\"localhost\";"
grid=/etc/opensim/grids/demo
mkdir -p $grid/web
printf "[Const]\n    BaseURL = \"http://127.0.0.1\"\n    WebURL = \"http://127.0.0.1:8080\"\n    PublicPort = \"8002\"\n    PrivatePort = \"8003\"\n[DatabaseService]\n    ConnectionString = \"Data Source=localhost;Database=robust;User ID=os;Password=pw;\"\n[GridInfoService]\n    gridname = \"Demo\"\n" >$grid/Robust.HG.ini
# The config of a grid holds passwords: readable by the group of the web server only
chgrp -R www-data $grid && chmod 640 $grid/Robust.HG.ini
php -r "require \"/usr/share/w4os-engine/vendor/autoload.php\"; echo W4OS\\Engine\\Provisioning\\Web\\Snippets::render(\"caddy\", \"demo\", \"$grid\", \"/usr/share/w4os-helpers/public\", \"/run/php/php$php-fpm.sock\", \"http://127.0.0.1:8080\");" >$grid/web/demo.caddyfile
printf "{\n    admin off\n    auto_https off\n}\nhttp://127.0.0.1:8080 {\n    import $grid/web/demo.caddyfile\n}\n" >/etc/caddy/Caddyfile
check "the snippet of the kit hands the helpers to php-fpm" "grep -q \"php_fastcgi unix//run/php/php$php-fpm.sock\" $grid/web/demo.caddyfile && grep -q \"env OPENSIM_GRID demo\" $grid/web/demo.caddyfile"
"php-fpm$php" -D
(caddy run --config /etc/caddy/Caddyfile >/tmp/caddy.log 2>&1 &)
for i in $(seq 1 20); do curl -s -o /dev/null http://127.0.0.1:8080/ && break; sleep 1; done
check "php-fpm runs the helpers as www-data" "ps -o user= -C php-fpm$php | grep -q www-data"
check "the home page of the helpers answers, under their base" "[ \"\$(http_code http://127.0.0.1:8080/helpers/)\" = 200 ]"
sleep 3
check "the visit ran the tasks of the search, their state in the folder of the helpers" "grep -q \"\\\"status\\\":\\\"ran\\\"\" /var/cache/w4os-helpers/tasks/search-parse.demo.json"
check "the tables of the search are made" "mysql -N -e \"SHOW TABLES\" robust | grep -qx hostsregister"
check "nothing is written in the folders of the install" "[ -z \"\$(ls -A /var/lib/opensim/cron 2>/dev/null)\" ]"
key=$(php -r "require \"/usr/share/w4os-engine/vendor/autoload.php\"; echo W4OS\\Engine\\Security\\ApiKeys::for(W4OS\\Engine\\Runtime\\Environment::system(W4OS\\Engine\\Config\\Layout::resolve()))->create(\"check\")[\"key\"];")
check "the health page is closed without a key" "[ \"\$(http_code http://127.0.0.1:8080/helpers/health)\" = 401 ]"
# One row a line, the spaces between the tags out
curl -s -H "Authorization: Bearer $key" http://127.0.0.1:8080/helpers/health | tr -d "\n" | sed -e "s/>[[:space:]]*</></g" -e "s#<tr #\n<tr #g" >/tmp/health.rows
check "the health page tells the folders of the tasks and the pictures can be written, the helpers own" "grep \"scope=.row.>tasks<\" /tmp/health.rows | grep -q \"health-ok.*/var/cache/w4os-helpers/tasks\" && grep \"scope=.row.>assets<\" /tmp/health.rows | grep -q \"health-ok.*/var/cache/w4os-helpers/cache\""

echo "A picture of the grid"
mysql robust -e "CREATE TABLE assets (name VARCHAR(64), description VARCHAR(64), assetType TINYINT, local TINYINT, temporary TINYINT, data LONGBLOB, id CHAR(36) PRIMARY KEY, create_time INT, access_time INT, asset_flags INT, CreatorID VARCHAR(128))"
convert -size 16x16 xc:red /tmp/red.jp2
php -r "\$pdo = new PDO(\"mysql:host=localhost;dbname=robust\", \"os\", \"pw\"); \$pdo->prepare(\"INSERT INTO assets VALUES (\\\"red\\\", \\\"\\\", 0, 0, 0, ?, \\\"aaaaaaaa-0000-4000-8000-000000000001\\\", 0, 0, 0, \\\"\\\")\")->execute([file_get_contents(\"/tmp/red.jp2\")]);"
picture=http://127.0.0.1:8080/helpers/pictures/aaaaaaaa-0000-4000-8000-000000000001.png
check "a texture of the grid is served as a picture" "[ \"\$(curl -s -o /tmp/red.png -w %{content_type} $picture)\" = image/png ] && [ -s /tmp/red.png ]"
check "the picture is kept in the cache of the helpers" "ls /var/cache/w4os-helpers/cache/demo/assets/images/ | grep -q aaaaaaaa-0000-4000-8000-000000000001"

echo "An upgrade from the name of before w4os, the zip"
dpkg -r opensim-helpers w4os-helpers >/dev/null 2>&1
previous opensim-helpers opensim-engine opensim-rest-php
mkdir -p /var/cache/opensim-helpers/tasks
# The empty package first, as apt orders them: dpkg alone does not deconfigure what the new one breaks
dpkg -i "$(newest /dist opensim-helpers)" "$(newest /dist w4os-helpers)" >/dev/null 2>&1
check "an upgrade from opensim-helpers brings w4os-helpers, the old name an empty package" "dpkg-query -W -f=\"\\\${db:Status-Abbrev}\\n\" w4os-helpers opensim-helpers | grep -c ^ii | grep -qx 2 && dpkg -s opensim-helpers | grep -q \"^Depends:.*w4os-helpers\" && [ ! -e /usr/share/opensim-helpers ] && [ ! -e /var/cache/opensim-helpers ]"
check "the libraries are links after the upgrade, not empty folders" "[ -L /usr/share/w4os-helpers/vendor/w4os/w4os-engine ] && [ -L /usr/share/w4os-helpers/vendor/magicoli/opensim-rest-php ] && [ -f /usr/share/w4os-helpers/vendor/w4os/w4os-engine/src/Models/Grid.php ]"
mkdir /tmp/zip && cd /tmp/zip && unzip -q "$(ls -v /dist/*.zip | tail -1)"
check "the zip has the helpers and a complete vendor folder, no composer.lock, no tests" "[ -f w4os-helpers/public/index.php ] && [ -f w4os-helpers/vendor/twig/twig/src/Environment.php ] && [ -f w4os-helpers/vendor/w4os/w4os-engine/src/Models/Grid.php ] && [ ! -L w4os-helpers/vendor/w4os/w4os-engine ] && [ ! -e w4os-helpers/composer.lock ] && [ ! -e w4os-helpers/tests ]"
chmod -R a+rX /tmp/zip
(cd /tmp/zip/w4os-helpers/public && runuser -u www-data -- env OPENSIM_GRID=demo php -S 127.0.0.1:8092 index.php >/tmp/zip.log 2>&1 &)
sleep 2
check "from the zip the home page answers too" "[ \"\$(http_code http://127.0.0.1:8092/helpers/)\" = 200 ]"
[ $status = 0 ] || { echo "--- caddy"; tail -5 /tmp/caddy.log; echo "--- php-fpm"; tail -5 /var/log/php$php-fpm.log 2>/dev/null; echo "--- health"; head -c 300 /tmp/health.rows; grep -i "tasks\|assets" /tmp/health.rows | head -4; ls -l /var/lib/opensim/api-keys.json 2>&1; }
exit $status'
